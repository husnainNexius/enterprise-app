# ============================================================
# DATA PIPELINE - ENVIRONMENT VARIABLES
# Copy this to .env and fill in your credentials
# ============================================================

# --- Step 1: COLLECT (Source Database) ---
SOURCE_DB_URL=postgresql://readonly_user:YOUR_PASSWORD@localhost:5432/your_database

# --- Step 1: COLLECT (API Keys) ---
API_BASE_URL=https://jsonplaceholder.typicode.com
API_KEY=your_api_key_here

# --- Step 2: STORE RAW (Google Cloud Storage) ---
GCP_PROJECT_ID=your-gcp-project-id
GCS_BUCKET_RAW=your-company-raw-data
GCS_BUCKET_PROCESSED=your-company-processed-data
GOOGLE_APPLICATION_CREDENTIALS=./credentials/service-account.json

# --- Step 4: WAREHOUSE (BigQuery) ---
BIGQUERY_PROJECT=your-gcp-project-id
BIGQUERY_DATASET_RAW=raw_postgres
BIGQUERY_DATASET_STAGING=staging
BIGQUERY_DATASET_ANALYTICS=analytics
BIGQUERY_DATASET_REPORTING=reporting
BIGQUERY_LOCATION=US

# --- Step 6: SCHEDULE (Airflow) ---
AIRFLOW_HOME=./orchestration
AIRFLOW__CORE__FERNET_KEY=your_fernet_key_here

# --- Step 7: SERVE (API) ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Step 8: MONITOR (Slack Alerts) ---
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
ALERT_EMAIL=data-team@yourcompany.com
